node_modules/
scratch/
.env
.env.local
# The asset records live one per prop in packages/props/src/models/<id>/thaikit.json;
# the store's lock and its atomic-write temp files sit beside them.
packages/props/src/models/.lock/
**/thaikit.json.tmp-*
**/colliders.json.tmp-*
# The CommonJS bundle is a BUILD PRODUCT of the pack installer (under /packs/),
# never something that lives in the source tree.
packages/props/src/models/*/model.bundle.js
packages/props/src/models/*/model.bundle.js.map
# The old slim consumer view; the vibe3d pack is the only product now.
/dist/
*.log
web/client/dist/
.DS_Store
.cabinet-meta
.repo.yaml
# Cabinet writes the mounted folder's page body here when the repo is opened
# as a KB page. Repo-root only -- index.md elsewhere in the tree is source.
/index.md
# Installed packs only -- anchored, because an unanchored `packs/` also matches
# scripts/lib/packs/, which is the pack INSTALLER and belongs in the repo.
/packs/
levels/*/build/
# The level GLB itself: it is rebuilt whole on every save and outgrew GitHub's
# 100 MB file limit (thepurge is 158 MB). The app still reads it at
# levels/<id>/level.glb; only the sky sidecars stay tracked.
levels/*/level.glb

render/level-harness.bundle.js

# The published vibe3d pack, regenerated by scripts/release-props.mjs. Like
# /packs/, it is re-downloadable -- from npm, or by re-running the export.
/packages/props/dist/

# render-model.mjs stdout/stderr captures
/render.json
/render.err
web/client/dist-public/

# The Unreal-ready copy of the kit (one GLB per prop), replaced whole by the
# asset editor's "export to Unreal"; re-creatable from the tree in a minute.
/exports/
