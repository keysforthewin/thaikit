# Generated images are binary. Never try to merge or diff them as text.
# Models are NOT here on purpose: a prop is a JavaScript module, so it diffs as
# text and a regeneration stays reviewable.
*.png   binary
*.webp  binary
*.jpg   binary

# Reference meshes live in gitignored scratch/, but mark them anyway in case one
# is ever committed deliberately.
*.glb   binary
*.gltf  binary

# Keep the registry diffable and merge-friendly.
registry.json text eol=lf
