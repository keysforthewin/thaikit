{
  "name": "thaikit",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "An MIT-licensed library of game-ready GLB props, and the skills that generate them.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "web/server",
    "web/client"
  ],
  "scripts": {
    "dev": "node web/server/src/index.js",
    "start": "NODE_ENV=production node web/server/src/index.js",
    "build": "npm run -w @thaikit/client build",
    "bootstrap": "node scripts/bootstrap-registry.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "test": "node --test packages/registry-core/test/*.test.mjs",
    "upload": "node --env-file=.env scripts/upload-to-fal.mjs",
    "migrate": "node scripts/migrate-registry.mjs",
    "blender": "node scripts/blender-preflight.mjs",
    "build:model": "node scripts/build-model-module.mjs",
    "render:model": "node scripts/render-model.mjs"
  },
  "dependencies": {
    "esbuild": "^0.25.0",
    "puppeteer-core": "^25.8.0",
    "sharp": "^0.35.3",
    "three": "^0.185.1"
  }
}
