{
  "name": "thaikit",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "An MIT-licensed library of game-ready GLB props, and the skills that generate them.",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "web/server",
    "web/client"
  ],
  "scripts": {
    "dev": "node web/server/src/index.js",
    "start": "NODE_ENV=production node web/server/src/index.js",
    "build": "npm run -w @thaikit/client build",
    "bootstrap": "node scripts/bootstrap-registry.mjs",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.mjs",
    "test": "node --test packages/registry-core/test/*.test.mjs packages/level-schema/test/*.test.mjs packages/level-runtime/test/*.test.mjs web/client/src/level/*.test.mjs scripts/level/*.test.mjs scripts/level/pipeline/*.test.mjs scripts/lib/*.test.mjs",
    "upload": "node --env-file=.env scripts/upload-to-fal.mjs",
    "migrate": "node scripts/migrate-registry.mjs",
    "blender": "node scripts/blender-preflight.mjs",
    "build:model": "node scripts/build-model-module.mjs",
    "render:model": "node scripts/render-model.mjs",
    "export:vibe3d": "node scripts/build-vibe3d-registry.mjs",
    "release:props": "./scripts/release-props.sh",
    "level:bake": "node scripts/level/bake-level.mjs",
    "level:verify": "node scripts/level/verify-level.mjs",
    "level:smoke": "node scripts/level/smoke-level.mjs",
    "level:probe": "node scripts/level/probe-lightmap.mjs",
    "level:calibrate": "node scripts/level/calibrate-sky-bake.mjs",
    "packs:install": "node scripts/install-pack.mjs",
    "compress:maps": "node scripts/compress-maps.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "^0.20.0",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "esbuild": "^0.25.0",
    "ktx-parse": "^1.1.0",
    "meshoptimizer": "^1.2.0",
    "puppeteer-core": "^25.8.0",
    "semver": "^7.8.5",
    "sharp": "^0.35.3",
    "tar": "^7.5.22",
    "three": "^0.185.1",
    "three-mesh-bvh": "^0.8.3"
  }
}
