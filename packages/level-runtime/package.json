{
  "name": "@thai-kit/level-runtime",
  "version": "0.1.1",
  "type": "module",
  "license": "MIT",
  "description": "Loads a level baked by the thaikit level editor into a three.js game: cells with LOD, lights and lightmap, physics colliders, per-cell BVH. Headless entry for servers.",
  "keywords": [
    "three",
    "threejs",
    "level",
    "gltf",
    "glb",
    "lightmap",
    "lod",
    "game",
    "webgl",
    "rapier"
  ],
  "homepage": "https://github.com/keysforthewin/thaikit/tree/main/packages/level-runtime#readme",
  "bugs": {
    "url": "https://github.com/keysforthewin/thaikit/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/keysforthewin/thaikit.git",
    "directory": "packages/level-runtime"
  },
  "author": "keysforthewin",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "src",
    "README.md"
  ],
  "exports": {
    ".": "./src/index.js",
    "./billboard": "./src/billboard.js",
    "./sky": "./src/sky.js",
    "./node": "./src/node.js",
    "./physics/rapier": "./src/physics/rapier.js",
    "./physics/null": "./src/physics/null.js",
    "./environment": "./src/environment.js"
  },
  "peerDependencies": {
    "three": ">=0.185.0",
    "@dimforge/rapier3d-compat": ">=0.12.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "@dimforge/rapier3d-compat": {
      "optional": true
    }
  },
  "dependencies": {
    "@thai-kit/level-schema": "^0.1.0",
    "three-mesh-bvh": "^0.8.3"
  }
}
