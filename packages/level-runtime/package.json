{
  "name": "@thaikit/level-runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "Loads a level baked by the thaikit level editor into a three.js game: cells with LOD, lights and lightmap, physics colliders, per-cell BVH. Headless entry for servers.",
  "exports": {
    ".": "./src/index.js",
    "./billboard": "./src/billboard.js",
    "./sky": "./src/sky.js",
    "./node": "./src/node.js",
    "./physics/rapier": "./src/physics/rapier.js",
    "./physics/null": "./src/physics/null.js"
  },
  "peerDependencies": {
    "three": ">=0.185.0",
    "@dimforge/rapier3d-compat": ">=0.12.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "@dimforge/rapier3d-compat": {
      "optional": true
    }
  },
  "dependencies": {
    "@thaikit/level-schema": "*",
    "three-mesh-bvh": "^0.8.3"
  }
}
