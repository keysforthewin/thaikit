# Port for the registry browser.
THAIKIT_PORT=3733

# The container runs as this uid:gid so files it writes into the bind-mounted
# repo stay owned by you. Defaults to 1000:1000. If `id -u` differs, set these
# or the server starts read-only.
#   echo "THAIKIT_UID=$(id -u)" >> .env
#   echo "THAIKIT_GID=$(id -g)" >> .env
THAIKIT_UID=1000
THAIKIT_GID=1000

# fal.ai API key, used ONLY by scripts/upload-to-fal.mjs to push local files to
# the fal CDN. Generation still goes through the fal-ai MCP server, which is
# reached over HTTP and therefore cannot read this machine's filesystem -- that
# is the whole reason this key exists here. Same key as the MCP Authorization
# header. Format: <key_id>:<key_secret>
#   npm run upload -- assets/<id>/preview.jpg
FAL_KEY=

# --- Blender bridge (kept, but unused) -------------------------------------
# No skill opens Blender any more: props are procedural Three.js code. This
# wiring stays for ad-hoc work, so a closed Blender is expected and harmless.
# It reaches the BlenderMCP addon inside a LIVE Blender session through the
# `blender` MCP server (uvx blender-mcp) -- a socket client, not a headless
# driver.
#
# On WSL with networkingMode=mirrored the addon is reachable on the host's
# loopback, so the defaults below usually need no change.
THAIKIT_BLENDER_HOST=127.0.0.1
THAIKIT_BLENDER_PORT=9876

# How Blender should spell the path to THIS repo. Blender runs on Windows and
# cannot see WSL's filesystem as /home/..., so files are exchanged over UNC.
# Leave unset to have scripts/lib/blender.mjs derive it from $WSL_DISTRO_NAME:
#   \\wsl.localhost\Ubuntu-22.04\home\you\code\thaikit
# Set it when Blender and the repo are on the same OS (then it is just the
# repo's absolute path).
THAIKIT_BLENDER_REPO_PATH=
